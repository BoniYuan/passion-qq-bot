# Compose 使用的时区
TZ=Asia/Shanghai

# NapCat 容器进程权限。Linux 可运行 `id -u` 和 `id -g` 查看。
NAPCAT_UID=1000
NAPCAT_GID=1000
NAPCAT_ACCOUNT=3470541417
NAPCAT_QUICK_PASSWORD=

# NapCat WebUI 登录令牌，请改成随机长字符串。
NAPCAT_WEBUI_TOKEN=change-this-to-a-long-random-string

# QQ 官方机器人（AppSecret 只写在服务器 .env，不要提交或发到聊天）
QQ_OFFICIAL_APP_ID=
QQ_OFFICIAL_APP_SECRET=
QQ_OFFICIAL_TEST_GROUP=
